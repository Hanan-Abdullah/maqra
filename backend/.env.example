# Copy this file to .env and adjust the values. Never commit .env.

# Port the backend listens on (8061 and 6060 are taken on the dev machine).
PORT=3010

# MongoDB connection (compose.yaml exposes the local database on 27018).
MONGO_URL=mongodb://127.0.0.1:27018
MONGO_DB=maqra

# Public address of the site, used to build the links returned to the skill.
PUBLIC_URL=http://localhost:3010